# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Vercel or Cloud Run.
APP_URL="https://your-amapati-app.vercel.app"

# SUPABASE INTEGRATION (Optional - for connected Supabase cloud database):
# Provide your Supabase project URL and anon public key.
# If omitted, Amapati seamlessly runs in standalone storage mode.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
